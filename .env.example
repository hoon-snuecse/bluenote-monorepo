# Bluenote Monorepo Environment Variables Example
# Copy this file to .env.local in each app directory and fill in the values

## Common Authentication Variables (Required for all apps)
# NextAuth
NEXTAUTH_SECRET=your-nextauth-secret-here
NEXTAUTH_URL=http://localhost:3000  # Change port for each app (3000, 3002, 3003)

# Google OAuth (Required for authentication)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

## Database Configuration
# Supabase (Used by Web and Quiz apps)
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# SQLite (Used by Grading app)
DATABASE_URL="file:./dev.db"

## AI Services
# Claude API (Required for AI features)
ANTHROPIC_API_KEY=your-anthropic-api-key
CLAUDE_API_KEY=your-claude-api-key  # Same as ANTHROPIC_API_KEY

# OpenAI (Optional, for Grading app)
OPENAI_API_KEY=your-openai-api-key

## Admin Configuration
ADMIN_EMAILS=admin@example.com,admin2@example.com

## App-Specific Variables
# Web app (port 3000)
# - No additional variables required

# Grading app (port 3002)
JWT_SECRET=your-jwt-secret-for-grading
ENCRYPTION_KEY=your-encryption-key-for-grading
NEXT_PUBLIC_BASE_URL=http://localhost:3002

# Quiz app (port 3003)
# - No additional variables required

## Production URLs
# Web: https://bluenote.site
# Grading: https://grading.bluenote.site
# Quiz: https://quiz.bluenote.site

## Notes
# 1. All apps share the same NEXTAUTH_SECRET for cross-domain session sharing
# 2. Google Drive API scope has been removed from authentication
# 3. Each app runs on a different port in development
# 4. Use the same Google OAuth credentials for all apps
